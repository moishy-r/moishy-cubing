# macOS
.DS_Store

# npm build output (dnt)
packages/*/npm/

# Editor / misc
*.log

# Generated demo bundle — built at deploy time by .github/workflows/pages.yml,
# so it is never committed and can never go stale against the source.
docs/apb-demo/apb.bundle.js

# CROP — generated by `deno task bundle:crop` from crop/core/, the single
# source of truth. Same reasoning as the demo bundle above: never committed,
# so it can never go stale against the source.
crop/extension/crop-core.js
crop/extension/crop-overlay.css
crop/extension/icons/
docs/crop/crop-core.js
docs/crop/crop-overlay.css
docs/crop/icons/
